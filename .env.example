# Kopiér til .env lokalt, eller sæt som "Application settings" i Azure App Service.

# local | dev | prod
APP_ENV=local

# Hvor database og uploadede billeder ligger. I Azure: /home/data (bliver gemt mellem genstarter).
DATA_DIR=./data

# Påkrævet i dev og prod. Lokalt er standarden "admin".
ADMIN_PASSWORD=

# Bruges til at signere login-cookien. Lad være tom lokalt (genereres). Sæt en lang tilfældig streng i Azure.
SECRET_KEY=

# test = beskeder logges men sendes ikke. live = sendes rigtigt.
NOTIFY_MODE=test

# SMS via GatewayAPI (https://gatewayapi.com). Token findes under API > API Keys.
GATEWAYAPI_TOKEN=
# EU-konti kan bruge https://gatewayapi.eu/rest/mtsms
GATEWAYAPI_URL=https://gatewayapi.com/rest/mtsms

# E-mail via SMTP. Microsoft 365: smtp.office365.com, port 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# Opret en demo-kunde ved første start (sæt til false i prod)
SEED_DEMO=true
